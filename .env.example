# Required: Happ/v2RayTun wrapper, encrypted link, or plain HTTPS subscription URL
SUBSCRIPTION_URL=https://example.com/subscription

# Optional Happ fetch headers (hpwnr aliases: happ, incy, v2, v2ray, v2raytun)
# HPWNR_UA=happ
# HPWNR_HWID=

# SOCKS5 listener inside the container (publish ports yourself, e.g. docker run -p 1080:1080)
SOCKS_LISTEN=0.0.0.0
SOCKS_PORT=1080

# Optional SOCKS authentication
# SOCKS_USER=
# SOCKS_PASS=

# Node selection: only one URI is converted (default index 0). Change via Web UI or:
# SELECTED_URI_INDEX=0
# OUTBOUND_TAG=my-node-name

# Web UI to pick subscription URI (http://host:8080/)
WEBUI_PORT=8080
WEBUI_LISTEN=0.0.0.0
# WEBUI_ENABLE=0

# Slow automatic probing of every node (off by default)
# ENABLE_URLTEST=1

# Subscription refresh interval in seconds
REFRESH_INTERVAL=3600

# sing-box logging
# SINGBOX_LOG_LEVEL=info
